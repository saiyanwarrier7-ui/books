# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL runtime environment variables (injected automatically in Cloud SQL enabled environments)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="itstudyhub"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="admin_password"
